+                               ROW_NUMBER() OVER (PARTITION BY b.ProductCode, ISNULL(b.Barcode, '') ORDER BY b.QtySold DESC, b.TotalAmount DESC) AS rn
+                        FROM dbo.BatchSalesDetails b
